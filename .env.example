# NeuroScan AI - Environment Variables
# Copy this file to .env and adjust values

# ---- Application ----
APP_NAME=NeuroScan AI
APP_VERSION=0.1.0
DEBUG=false

# ---- API Server ----
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# ---- Inference ----
# Set to true to use mock predictions (no trained models needed)
MOCK_INFERENCE=true
CONFIDENCE_THRESHOLD=0.7

# ---- Storage ----
UPLOAD_DIR=./data/uploads
MODEL_DIR=./models/registry
MAX_FILE_SIZE_MB=500
RETENTION_DAYS=30

# ---- Database ----
DATABASE_URL=sqlite:///./data/audit.db

# ---- Security ----
API_KEY=changeme-in-production
SECRET_KEY=changeme-in-production-use-a-real-secret

# ---- Frontend ----
API_BASE_URL=http://localhost:8000

# ---- MLOps (optional) ----
# MLFLOW_TRACKING_URI=http://localhost:5000
# WANDB_API_KEY=your-key-here
# WANDB_PROJECT=neuroscan-ai

